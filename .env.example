# Copy to `.env` (gitignored) and fill in. Nothing here is read by the deployed
# app — `.env` is local-only.

# --- paper-finder publish (local dev only) ---
# Supabase -> Project Settings -> Database -> Connection string -> Session pooler
# (IPv4, port 5432, user postgres.<project-ref>). NOT the 6543 transaction pooler.
SUPABASE_DB_URL=

# --- local "cloud mode" preview of the web UI (optional) ---
# Only set these if you want `paper-finder serve` to behave like the deployed
# site (email-code login + Supabase search) instead of local SQLite. Normally
# leave blank. These same two values go in the Vercel project's env variables.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
