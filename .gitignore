# --- Paper Finder data (never committed) ---
# Downloaded CIE past papers are copyright of Cambridge Assessment; the extracted
# question bank is derived from them. Keep both out of version control, but keep
# the folders themselves (via .gitkeep) so the layout is obvious.
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md
data/processed/*
!data/processed/.gitkeep
data/crops/*
!data/crops/.gitkeep
data/download_log.csv
*.pdf
papers.db
papers.db-journal
papers.db-wal
papers.db-shm
*.npy

# --- Python ---
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/

# --- Secrets / deployment ---
.env
.env.*
!.env.example
.vercel/

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- AI coding tools (per-machine installs and config) ---
CLAUDE.local.md
.claude/settings.local.json
# Third-party agent skills installed by `npx skills add` (restorable from the
# lock file, which is local too): the skill sources, Claude Code's symlinks to
# them, and the lock file itself.
.agents/
.claude/skills/
skills-lock.json
# Codex CLI config (MCP server list)
.codex/

# --- Reference syllabus material (copyright CIE / textbook publishers) ---
Required Syllabuses/

# --- UI reference screenshots (third-party site captures, not ours) ---
Ref Photos/

# session scratch — never commit (may contain extracted CIE question text)
scratchpad/
